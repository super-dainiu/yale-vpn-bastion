#!/opt/yale-vpn/venv/bin/python3
"""Finish Yale's Microsoft/Duo browser login for OpenConnect."""

from __future__ import annotations

import os
import shutil
import sys
import tempfile
import time
from urllib.parse import urlsplit, urlunsplit

from playwright.sync_api import Error as PlaywrightError
from playwright.sync_api import Locator, Page, sync_playwright

USER = os.environ.pop("YALE_SSO_USER", "")
PASSWORD = os.environ.pop("YALE_SSO_PASSWORD", "")
TIMEOUT = int(os.environ.get("YALE_SSO_TIMEOUT", "360"))

# Chromium ships under /opt so root can reach it without a home directory.
os.environ.setdefault("PLAYWRIGHT_BROWSERS_PATH", "/opt/yale-vpn/browsers")

CLICKABLE = "button, a, input[type=submit], [role=button], label"
DONE_PREFIX = "http://localhost:29786/"

# Microsoft's email page carries a 10x13 px decoy password box that Playwright
# reports as visible. Without a width floor the login believes it is already on
# the password step, so it never submits the email and stalls there until the
# timeout. Real fields are full width.
FIELD_MIN_WIDTH = 100


def log(message: str) -> None:
    print(f"[yale-sso] {message}", file=sys.stderr, flush=True)


def first(page: Page, *selectors: str, min_width: float = 0) -> Locator | None:
    """First visible, enabled match for any selector, searched across frames.

    Duo renders inside an iframe, so every lookup spans page.frames rather
    than tracking which frame is current the way switch_to.frame did.

    min_width skips matches narrower than that, which is what separates a
    real input from a decoy one.
    """
    for selector in selectors:
        for frame in page.frames:
            try:
                locator = frame.locator(selector)
                for index in range(min(locator.count(), 8)):
                    candidate = locator.nth(index)
                    if not (candidate.is_visible() and candidate.is_enabled()):
                        continue
                    if min_width:
                        box = candidate.bounding_box()
                        if box is None or box["width"] < min_width:
                            continue
                    return candidate
            except PlaywrightError:
                pass
    return None


def wait_for(
    page: Page, *selectors: str, seconds: int = 40, min_width: float = 0
) -> Locator:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        found = first(page, *selectors, min_width=min_width)
        if found is not None:
            return found
        page.wait_for_timeout(250)
    raise TimeoutError(f"no element matched {selectors}")


def submit(page: Page, field: Locator) -> None:
    button = first(page, "input[type=submit]", "button[type=submit]", "button")
    try:
        if button is not None:
            button.click(timeout=5000)
        else:
            field.press("Enter", timeout=5000)
    except PlaywrightError:
        try:
            field.press("Enter", timeout=5000)
        except PlaywrightError:
            pass


def page_text(page: Page) -> str:
    text = []
    for frame in page.frames:
        try:
            text.append(frame.inner_text("body", timeout=2000))
        except PlaywrightError:
            pass
    return "\n".join(text).casefold()


def click_text(page: Page, *needles: str) -> bool:
    for frame in page.frames:
        try:
            locator = frame.locator(CLICKABLE)
            count = min(locator.count(), 40)
        except PlaywrightError:
            continue
        for index in range(count):
            element = locator.nth(index)
            try:
                if not (element.is_visible() and element.is_enabled()):
                    continue
                label = (
                    element.inner_text(timeout=1000)
                    or element.get_attribute("value")
                    or element.get_attribute("aria-label")
                    or ""
                ).strip()
                if any(needle in label.casefold() for needle in needles):
                    element.click(timeout=5000)
                    return True
            except PlaywrightError:
                pass
    return False


def authenticate(page: Page) -> None:
    username = first(
        page,
        "input[type=email]",
        "input[autocomplete=username]",
        "input[name=loginfmt]",
        min_width=FIELD_MIN_WIDTH,
    )
    password = first(
        page,
        "input[type=password]",
        "input[autocomplete=current-password]",
        min_width=FIELD_MIN_WIDTH,
    )

    if username is not None and password is None:
        log("Submitting Yale email")
        username.fill(USER)
        submit(page, username)
        password = wait_for(
            page,
            "input[type=password]",
            "input[autocomplete=current-password]",
            min_width=FIELD_MIN_WIDTH,
        )

    password = password or wait_for(
        page,
        "input[type=password]",
        "input[autocomplete=current-password]",
        min_width=FIELD_MIN_WIDTH,
    )
    log("Submitting NetID password")
    password.fill(PASSWORD)
    submit(page, password)

    deadline = time.monotonic() + TIMEOUT
    last_click: dict[str, float] = {}
    push_logged = False

    def click_every(name: str, seconds: int, *needles: str) -> bool:
        now = time.monotonic()
        if now - last_click.get(name, 0) < seconds:
            return False
        if click_text(page, *needles):
            last_click[name] = now
            return True
        return False

    while time.monotonic() < deadline:
        if page.url.startswith(DONE_PREFIX):
            log("Authentication complete")
            return

        text = page_text(page)
        if "validation failure" in text:
            raise RuntimeError("Yale rejected or expired the SAML response")

        stay_signed_in = first(page, "#idBtn_Back")
        if "stay signed in" in text and stay_signed_in is not None:
            stay_signed_in.click(timeout=5000)
            page.wait_for_timeout(2000)
            continue

        if click_every(
            "duo",
            8,
            "approve with duo",
            "duo security",
            "duo push",
            "send me a push",
            "send a push",
            "verify with duo",
            "continue",
        ):
            log("Duo is ready; approve the push if prompted")

        if click_every(
            "shared-device",
            8,
            "no, other people use this device",
            "this is a shared device",
        ):
            log("Duo approved")

        if not push_logged and (
            "check for a duo push" in text or "sent a push" in text
        ):
            log("Duo push sent")
            push_logged = True

        page.wait_for_timeout(1000)

    raise TimeoutError("timed out waiting for Yale/Duo")


def main() -> int:
    if len(sys.argv) != 2:
        log("usage: yale-sso-browser SAML_URL")
        return 2

    runtime = "/run/yale-vpn"
    os.makedirs(runtime, mode=0o700, exist_ok=True)
    # /run is tmpfs, so the profile never reaches disk.
    profile = tempfile.mkdtemp(prefix="chrome-", dir=runtime)

    page: Page | None = None
    try:
        with sync_playwright() as driver:
            context = driver.chromium.launch_persistent_context(
                profile,
                headless=True,
                args=[
                    "--no-sandbox",
                    "--disable-dev-shm-usage",
                    "--disable-gpu",
                    "--disable-extensions",
                    "--no-first-run",
                    "--password-store=basic",
                ],
            )
            try:
                page = context.pages[0] if context.pages else context.new_page()
                page.set_default_timeout(30000)
                page.goto(sys.argv[1], wait_until="domcontentloaded", timeout=30000)

                if not USER or not PASSWORD:
                    log("browser probe succeeded")
                    return 3

                authenticate(page)
                return 0
            finally:
                context.close()
    except Exception as error:
        log(f"{type(error).__name__}: {error}")
        if page is not None:
            try:
                url = urlsplit(page.url)
                safe_url = urlunsplit((url.scheme, url.netloc, url.path, "", ""))
                log(f"Stopped at {safe_url}")
            except PlaywrightError:
                pass
        return 1
    finally:
        shutil.rmtree(profile, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
