#!/usr/bin/env bash
set -Eeuo pipefail

TUN=yalevpn
RUNTIME=/run/yale-vpn
ENDPOINT=https://access.yale.edu
USER_AGENT='AnyConnect Linux_64 4.10.07061'
VENV=/opt/yale-vpn/venv
SLICE="$VENV/bin/vpn-slice"

# Yale's BGP-announced prefixes (AS29) plus the internal resolver subnet.
# These are the only destinations that enter the tunnel; the default route
# is never touched, so SSH, Tailscale and everything else stay direct.
YALE_ROUTES=(
  128.36.0.0/16
  130.132.0.0/16
  192.31.2.0/24
  192.31.236.0/24
  192.35.89.0/24
  172.18.190.0/24
)

# Names only Yale's internal resolver knows. vpn-slice resolves them once at
# connect time and writes /etc/hosts, so no query ever has to leave for Yale
# DNS -- which matters because Tailscale owns /etc/resolv.conf here.
# Keep in step with the cluster hosts in ssh_config.
YALE_HOSTS=(
  bouchet.ycrc.yale.edu
  grace.ycrc.yale.edu
  mccleary.ycrc.yale.edu
  login1.misha.ycrc.yale.edu
)

slice_command() {
  local parts=("$SLICE" --route-splits --no-ns-hosts)
  [[ -n ${YALE_VPN_DUMP:-} ]] && parts+=(--dump)
  parts+=("${YALE_ROUTES[@]}" "${YALE_HOSTS[@]}")
  # openconnect runs --script through the shell, so quote every word.
  printf '%q ' "${parts[@]}"
}

default_route_is_ours() {
  ! ip route show default | grep -q "dev ${TUN}\b"
}

connect() {
  pgrep -x openconnect >/dev/null && {
    echo "VPN is already running"
    status
    return
  }

  install -d -m 0700 "$RUNTIME"
  username="${1:-}"
  [[ -n $username ]] || read -r -p "Yale email (First.Last@yale.edu): " username
  read -r -s -p "NetID password: " YALE_SSO_PASSWORD
  printf '\n'
  [[ -n $YALE_SSO_PASSWORD ]] || {
    echo "Password cannot be empty" >&2
    return 2
  }

  trap 'unset YALE_SSO_PASSWORD YALE_SSO_USER auth COOKIE' EXIT
  export YALE_SSO_USER="$username" YALE_SSO_PASSWORD
  echo "Signing in with headless Chromium. Approve Duo if it appears."
  if ! auth=$(
    openconnect \
      --protocol=anyconnect \
      --useragent="$USER_AGENT" \
      --external-browser=/usr/local/sbin/yale-sso-browser \
      --authenticate \
      "$ENDPOINT"
  ); then
    echo "Yale authentication failed" >&2
    return 1
  fi
  unset YALE_SSO_PASSWORD YALE_SSO_USER

  # --authenticate emits shell-quoted COOKIE, HOST, FINGERPRINT and RESOLVE.
  eval "$auth"
  target="${CONNECT_URL:-${HOST:-}}"
  [[ -n ${COOKIE:-} && -n ${FINGERPRINT:-} && -n $target ]]

  args=(
    --protocol=anyconnect
    --useragent="$USER_AGENT"
    --interface="$TUN"
    --script "$(slice_command)"
    --background
    --pid-file="$RUNTIME/openconnect.pid"
    --servercert="$FINGERPRINT"
    --syslog
    --timestamp
    --cookie-on-stdin
  )
  [[ -z ${RESOLVE:-} ]] || args+=(--resolve="$RESOLVE")

  printf '%s\n' "$COOKIE" | openconnect "${args[@]}" "$target"
  unset COOKIE auth
  sleep 2
  status
}

disconnect() {
  # vpn-slice removes its own routes and /etc/hosts entries on teardown.
  if [[ -s $RUNTIME/openconnect.pid ]]; then
    kill -INT "$(<"$RUNTIME/openconnect.pid")" 2>/dev/null || true
  fi
  pkill -INT -x openconnect 2>/dev/null || true
  unlink "$RUNTIME/openconnect.pid" 2>/dev/null || true
}

routes() {
  echo "Routed into the tunnel:"
  ip route show dev "$TUN" 2>/dev/null | sed 's/^/  /' || echo "  (tunnel is down)"
  echo "Yale names in /etc/hosts:"
  grep -i 'vpn-slice' /etc/hosts 2>/dev/null | sed 's/^/  /' || echo "  (none)"
}

status() {
  pgrep -a -x openconnect || echo "VPN is not running"
  ip -brief -4 address show "$TUN" 2>/dev/null || true
  if default_route_is_ours; then
    echo "Default route: unchanged (split tunnel)"
  else
    echo "WARNING: the tunnel captured the default route" >&2
  fi
  printf 'Public IP: '
  curl -4fsS --max-time 10 https://checkip.amazonaws.com || true
}

[[ ${EUID} -eq 0 ]] || {
  echo "Run with sudo" >&2
  exit 2
}

case "${1:-}" in
  connect) connect "${2:-}" ;;
  disconnect) disconnect ;;
  routes) routes ;;
  status) status ;;
  *)
    echo "usage: yale-vpn {connect [EMAIL]|disconnect|status|routes}" >&2
    exit 2
    ;;
esac
